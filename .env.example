# review-agent 环境变量配置
# 复制为 .env 并填入实际值

# 应用基础
REVIEW_AGENT_APP_NAME=review-agent
REVIEW_AGENT_DEBUG=false
REVIEW_AGENT_LOG_LEVEL=INFO

# 数据库
REVIEW_AGENT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/review_agent

# Redis
REVIEW_AGENT_REDIS_URL=redis://localhost:6379/0
REVIEW_AGENT_ARQ_REDIS_URL=redis://localhost:6379/1

# AI 模型（DeepSeek）
REVIEW_AGENT_AI_MODEL_NAME=deepseek-v4-flash
REVIEW_AGENT_AI_ECONOMY_MODEL=deepseek-v4-flash
REVIEW_AGENT_AI_BASE_URL=https://api.deepseek.com
REVIEW_AGENT_AI_API_KEY=
REVIEW_AGENT_AI_REQUEST_TIMEOUT=30
REVIEW_AGENT_AI_MAX_RETRIES=1

# Git 平台
REVIEW_AGENT_GITHUB_TOKEN=

# OpenTelemetry（可选）
REVIEW_AGENT_OTEL_ENABLED=false
REVIEW_AGENT_OTEL_SERVICE_NAME=review-agent
REVIEW_AGENT_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# 启用 langgraph 集成
REVIEW_AGENT_USE_LANGGRAPH=true

# ngrok 配置（如果需要暴露本地服务）
REVIEW_AGENT_PUBLIC_URL=